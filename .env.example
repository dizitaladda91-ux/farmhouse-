# Copy the complete connection string from Neon Console > Connect.
# Keep sslmode=require and channel_binding=require as supplied by Neon.
DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SECRET_KEY=generate-a-unique-32-plus-character-secret-here

# JSON array only. Replace with the exact deployed frontend URLs; no localhost in production.
BACKEND_CORS_ORIGINS=["https://www.example.com","https://example.com"]

# Browser-facing API URL. This value is embedded during the Next.js build.
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Use only for the one-time `python -m app.scripts.create_admin` command.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-strong-unique-password-here
ADMIN_FULL_NAME=Platform Administrator
